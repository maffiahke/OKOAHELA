DATABASE_URL="file:./dev.db"
AUTH_SECRET="replace-with-a-long-random-secret"

# M-Pesa Daraja — LIVE credentials required ("production" or "sandbox")
MPESA_ENV="production"
MPESA_CONSUMER_KEY="your-daraja-consumer-key"
MPESA_CONSUMER_SECRET="your-daraja-consumer-secret"
MPESA_SHORTCODE="your-paybill-or-shortcode"
MPESA_PASSKEY="your-daraja-passkey"
# Must be publicly reachable HTTPS so Safaricom can post STK/B2C callbacks
MPESA_CALLBACK_URL="https://your-domain.com/api/mpesa/callback"
# B2C payouts (loan disbursement + savings withdrawal): Safaricom Dashboard
# -> Init API Calls -> "M-Pesa API B2C" initiator name and its password
MPESA_B2C_INITIATOR="api"
MPESA_B2C_PASSWORD="your-b2c-initiator-password"
